{
  "name": "mantel-android",
  "version": "2026.0.12",
  "private": true,
  "description": "Mantel VPN for Android",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production",
    "build:prod": "vite build --mode production",
    "build:debug": "vite build --mode debug",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:jvm": "npm run build:debug && npm run sync && node scripts/gradle.mjs testDebugUnitTest",
    "sync": "node scripts/cap.mjs sync android",
    "apk:prod": "npm run build:prod && npm run sync && node scripts/gradle.mjs assembleRelease",
    "apk:debug": "npm run build:debug && npm run sync && node scripts/gradle.mjs assembleDebug",
    "apk": "npm run apk:debug",
    "apk:release": "npm run apk:prod",
    "gradle": "node scripts/gradle.mjs",
    "emulator": "node scripts/emulator.mjs",
    "deploy": "node scripts/deploy.mjs",
    "logcat": "node scripts/logcat.mjs",
    "open": "node scripts/cap.mjs open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "clsx": "2.1.1",
    "motion": "14.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "license": "GPL-3.0-only",
  "packageManager": "npm@11.20.0"
}
